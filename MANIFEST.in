include LICENSE
include README.md
include CHANGELOG.md
include AUTHORS.md
include CONTRIBUTING.md
include PARITY_FREEZE.md
include pyproject.toml
include setup.py
include build_support.py
include .gitattributes

recursive-include docs *
recursive-include examples *
recursive-include tests *.py *.cpp
recursive-include tests/fixtures *
recursive-include xstar_test_run *.csv *.md

recursive-include src/xstar_tools *.py *.def *.dat *.json *.csv *.h *.hpp *.cpp Makefile build_lib.sh README.md

recursive-include qualification/current *.py
recursive-include qualification/frozen *
recursive-include qualification/cross_platform_fixed_state_reference_0_6_88_6_1 *
include qualification/parity_freeze.json
include qualification/parity_freeze_science_hashes.json
include qualification/parity_freeze_current_source_hashes.json
include qualification/source_concordance.json
include qualification/documentation_coverage_closure_0_6_90_4.json
include qualification/documentation_build_outputs_0_6_90_5.json
include qualification/zone_cpp_0667_vs_cpp44_0_6_74.csv
include qualification/zone_cpp_0667_vs_cpp44_0_6_74.json
include qualification/zone_cpp_0667_reanalysis_0_6_74.csv
include qualification/zone_cpp_0667_reanalysis_0_6_74.json
include qualification/option24_comparator_policy_0_6_67.json

recursive-include tools/benchmarks *.sh
recursive-include tools/ci *.py
recursive-include tools/packaging *.py *.sh
recursive-include tools/qualification *.py
recursive-include tools/qualification/reference *
recursive-include tools/release *.py

recursive-include references/current *.json *.csv *.md
recursive-include references/xstinitable_0_6_83 *
recursive-include references/xstinitable_0_6_83_1 *

include .github/workflows/ci.yml
include .github/workflows/parity-freeze.yml
include .github/workflows/pypi-release.yml

prune historical
prune conda
prune .pytest_cache
prune src/xstar_tools.egg-info
global-exclude *.py[cod]
global-exclude __pycache__
